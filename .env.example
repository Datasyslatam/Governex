# ============================================================
#  Governex: plantilla de variables de entorno
#  Copiar como .env y completar. NUNCA subir el .env real al repositorio.
#  En Railway, definir estas mismas variables en el servicio.
# ============================================================

# ── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Base de datos (PostgreSQL) ──────────────────────────────
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/governex
# Opcional: "true" para validar el certificado SSL en conexiones externas.
DB_SSL_REJECT_UNAUTHORIZED=false

# ── Autenticación y sesiones (Fase 2) ───────────────────────
# Ya NO se usan JWT_SECRET ni PLATFORM_ADMIN_JWT_SECRET: las sesiones viven en
# el servidor (tabla `sesiones`) y el navegador solo guarda una cookie HttpOnly.
#
# OBLIGATORIA: cifra los secretos MFA (TOTP) en la BD con AES-256-GCM.
# 32 bytes en hex (64 caracteres). Sin ella el servidor NO arranca.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guárdala en un gestor de secretos: si se pierde, todos deben re-enrolar su MFA.
MFA_ENCRYPTION_KEY=
# Roles con MFA obligatorio (separados por coma; "*" = todos). Platform admins: siempre.
MFA_REQUIRED_ROLES=Superusuario
# Expiración de sesiones
SESSION_IDLE_MIN=30
SESSION_MAX_HOURS=8
PLATFORM_SESSION_MAX_HOURS=4
IMPERSONATION_MIN=30
# Bloqueo de cuenta por intentos fallidos
LOCKOUT_MAX_FAILURES=5
LOCKOUT_MINUTES=15

# ── IA: Google Gemini ───────────────────────────────────────
GEMINI_API_KEY=

# ── Almacenamiento de archivos: Cloudflare R2 (API S3) ──────
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_KEY=
R2_SECRET=
R2_BUCKET=

# ── Seguridad HTTP (opcionales) ─────────────────────────────
# Orígenes externos autorizados por CORS, separados por coma.
# Vacío = solo el mismo origen (recomendado: el frontend lo sirve este mismo servidor).
CORS_ORIGINS=
# Saltos de proxy de confianza delante de Express (Railway = 1).
TRUST_PROXY=1
# Tamaño máximo de cuerpos JSON del resto de la API.
JSON_BODY_LIMIT=1mb
# Tamaño máximo de cuerpos JSON en /api/gemini (imágenes y documentos en base64).
JSON_BODY_LIMIT_IA=15mb
# Peticiones máximas a /api por IP cada 5 minutos (freno contra abuso).
API_RATE_LIMIT_MAX=3000
# Solicitudes máximas a Governex IA por usuario cada 10 minutos.
IA_RATE_LIMIT_MAX=40

# ── Frontend (Vite) ─────────────────────────────────────────
# Vacío en producción (mismo servidor). En desarrollo, Vite hace de proxy de /api.
VITE_API_URL=
